# ============================================================
#  Nalar — Environment Variables
#  Salin ke .env.local lalu isi nilainya.
#  JANGAN commit file .env.local ke git.
# ============================================================

# ------------------------------------------------------------
# Supabase
# Ambil dari: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Hanya untuk server. Melewati RLS — jangan pernah diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------
# AI Provider 1 — Google AI Studio (Gemini)
# Ambil dari: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=AIza...
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=1536

# ------------------------------------------------------------
# AI Provider 2 — Groq
# Ambil dari: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL_ALT=openai/gpt-oss-20b
GROQ_CHAT_MODEL_FAST=qwen/qwen3.8-27b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ------------------------------------------------------------
# Perilaku rantai fallback
# ------------------------------------------------------------
# Urutan dipisah koma: provider:model
AI_CHAT_ROUTE=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# Budget total satu request (ms)
AI_REQUEST_DEADLINE_MS=45000
# Timeout sampai token pertama (ms)
AI_FIRST_TOKEN_TIMEOUT_MS=20000
# Percobaan ulang pada provider yang sama
AI_MAX_RETRY_PER_PROVIDER=1
# Circuit breaker
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_WINDOW_MS=60000
AI_BREAKER_OPEN_MS=60000
AI_BREAKER_AUTH_OPEN_MS=900000

# ------------------------------------------------------------
# Retrieval & konteks
# ------------------------------------------------------------
RETRIEVAL_VECTOR_TOP_K=30
RETRIEVAL_FTS_TOP_K=30
RETRIEVAL_FINAL_K=12
RETRIEVAL_RRF_K=60
CONTEXT_TOKEN_BUDGET=8000
CHAT_HISTORY_TURNS=4
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# ------------------------------------------------------------
# Batas upload & kuota
# ------------------------------------------------------------
MAX_FILE_SIZE_MB=25
MAX_BATCH_SIZE_MB=100
MAX_SOURCES_PER_NOTEBOOK=50
MAX_PDF_PAGES=500
MAX_NOTEBOOKS_PER_USER=20

DAILY_CHAT_LIMIT=100
DAILY_ARTIFACT_LIMIT=20
DAILY_UPLOAD_LIMIT=50
DAILY_TOKEN_LIMIT=300000

# ------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nalar
NODE_ENV=development
# Aktifkan detail error AI di respons API (jangan di production)
AI_DEBUG=false
